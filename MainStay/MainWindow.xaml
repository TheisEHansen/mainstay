<Window x:Class="MainStay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MainStay.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MainStay" Icon="Icon.ico" Height="680" Width="1040" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotRunning}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Root folder" Style="{StaticResource FieldLabel}" Margin="0,0,16,10" />
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Margin="0,0,8,10"
                         Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,10" Click="OnBrowseClick" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Main branch names" Style="{StaticResource FieldLabel}" Margin="0,0,16,10"
                           ToolTip="Comma-separated, tried in order. The remote's default branch is preferred." />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Field}" Margin="0,0,0,10"
                         Text="{Binding BranchNames, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parallel repositories" Style="{StaticResource FieldLabel}" Margin="0,0,16,10" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="72" Style="{StaticResource Field}"
                             Text="{Binding ThrottleLimit, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="Git timeout (seconds)" Style="{StaticResource FieldLabel}" Margin="32,0,16,0" />
                    <TextBox Width="72" Style="{StaticResource Field}"
                             Text="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Stay on main"
                          IsChecked="{Binding StayOnMain}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Run" Command="{Binding RunCommand}" IsDefault="True"
                            Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Export..." Click="OnExportClick" IsEnabled="{Binding CanExport}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Height="5" Minimum="0" Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                      BorderThickness="0" RowHeight="34"
                      SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                <Setter Property="Background" Value="#26D13438" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                <Setter Property="Background" Value="#26F7B500" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="350" />
                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    <DataGridCheckBoxColumn Header="Stashed" Binding="{Binding Stashed, Mode=OneWay}" Width="80" />
                    <DataGridTextColumn Header="Commits" Binding="{Binding Commits}" Width="80" />
                    <DataGridTextColumn Header="From" Binding="{Binding FromCommit}" Width="80" />
                    <DataGridTextColumn Header="To" Binding="{Binding ToCommit}" Width="80" />
                    <DataGridTextColumn Header="Time" Binding="{Binding Duration.TotalSeconds, StringFormat={}{0:0.0}s}" Width="60" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding Results.Count, StringFormat=Repositories: {0}}" />
    </Grid>
</Window>
